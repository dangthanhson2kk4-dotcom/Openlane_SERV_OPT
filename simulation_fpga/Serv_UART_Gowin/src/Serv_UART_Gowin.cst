// ============================================================
// Physical Constraints File (.cst) for Tang Nano 9K
// Fix lỗi CT1136 - Bank 3 Voltage Conflict
// ============================================================

// Clock 27MHz (Bank 2 - 3.3V)
IO_LOC "clk" 52;
IO_PORT "clk" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Reset (Nút S1 - Pin 4 - Bank 3)
IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP IO_TYPE=LVCMOS18;

// UART (Bank 1 - 3.3V)
IO_LOC "uart_tx" 17;
IO_PORT "uart_tx" PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "uart_rx" 18;
IO_PORT "uart_rx" PULL_MODE=UP IO_TYPE=LVCMOS33;

// 6 LED (Pin 10-16 - Tất cả nằm trong Bank 3 nên PHẢI là LVCMOS18)
IO_LOC "leds[0]" 10;
IO_PORT "leds[0]" PULL_MODE=UP IO_TYPE=LVCMOS18;

IO_LOC "leds[1]" 11;
IO_PORT "leds[1]" PULL_MODE=UP IO_TYPE=LVCMOS18;

IO_LOC "leds[2]" 13;
IO_PORT "leds[2]" PULL_MODE=UP IO_TYPE=LVCMOS18;

IO_LOC "leds[3]" 14;
IO_PORT "leds[3]" PULL_MODE=UP IO_TYPE=LVCMOS18;

IO_LOC "leds[4]" 15;
IO_PORT "leds[4]" PULL_MODE=UP IO_TYPE=LVCMOS18;

IO_LOC "leds[5]" 16;
IO_PORT "leds[5]" PULL_MODE=UP IO_TYPE=LVCMOS18;